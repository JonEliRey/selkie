{
  "status": "admitted",
  "reasons": [],
  "rule": {
    "id": "lumen-completed-value",
    "applies_to": {
      "tenant": "paper-kite",
      "risk_type": "lantern-watch"
    },
    "thresholds": [
      {
        "id": "lumen-completed-value.minimum-cents",
        "value": 1250,
        "min": 1250,
        "max": 1250,
        "step": 1
      }
    ],
    "conditions": [
      {
        "kind": "event_type",
        "operator": "eq",
        "value": "settlement"
      },
      {
        "kind": "membership",
        "field": "currency",
        "operator": "in",
        "values": [
          "USD"
        ]
      },
      {
        "kind": "field_constant",
        "field": "sum_lumen_completed",
        "operator": "gt",
        "threshold": "lumen-completed-value.minimum-cents"
      }
    ],
    "tests": [
      {
        "name": "one cent below",
        "row": {
          "tenant": "paper-kite",
          "risk_type": "lantern-watch",
          "kind": "settlement",
          "amount": 1,
          "currency": "USD",
          "fields": {
            "sum_lumen_completed": 1249,
            "sum_lumen_current": 0
          }
        },
        "expected": "did_not_match"
      },
      {
        "name": "exactly twelve dollars fifty",
        "row": {
          "tenant": "paper-kite",
          "risk_type": "lantern-watch",
          "kind": "settlement",
          "amount": 1,
          "currency": "USD",
          "fields": {
            "sum_lumen_completed": 1250,
            "sum_lumen_current": 0
          }
        },
        "expected": "did_not_match"
      },
      {
        "name": "one cent above",
        "row": {
          "tenant": "paper-kite",
          "risk_type": "lantern-watch",
          "kind": "settlement",
          "amount": 1,
          "currency": "USD",
          "fields": {
            "sum_lumen_completed": 1251,
            "sum_lumen_current": 0
          }
        },
        "expected": "matched"
      },
      {
        "name": "dollar-scaled mistaken input does not meet cents threshold",
        "row": {
          "tenant": "paper-kite",
          "risk_type": "lantern-watch",
          "kind": "settlement",
          "amount": 1,
          "currency": "USD",
          "fields": {
            "sum_lumen_completed": 13,
            "sum_lumen_current": 0
          }
        },
        "expected": "did_not_match"
      },
      {
        "name": "current day burst cannot replace completed window",
        "row": {
          "tenant": "paper-kite",
          "risk_type": "lantern-watch",
          "kind": "settlement",
          "amount": 1,
          "currency": "USD",
          "fields": {
            "sum_lumen_completed": 0,
            "sum_lumen_current": 9000
          }
        },
        "expected": "did_not_match"
      },
      {
        "name": "previous completed day wins even with quiet current day",
        "row": {
          "tenant": "paper-kite",
          "risk_type": "lantern-watch",
          "kind": "settlement",
          "amount": 1,
          "currency": "USD",
          "fields": {
            "sum_lumen_completed": 1251,
            "sum_lumen_current": 0
          }
        },
        "expected": "matched"
      },
      {
        "name": "other tenant",
        "row": {
          "tenant": "paper-boat",
          "risk_type": "lantern-watch",
          "kind": "settlement",
          "amount": 1,
          "currency": "USD",
          "fields": {
            "sum_lumen_completed": 9000,
            "sum_lumen_current": 0
          }
        },
        "expected": "not_applicable"
      },
      {
        "name": "other risk",
        "row": {
          "tenant": "paper-kite",
          "risk_type": "cloud-watch",
          "kind": "settlement",
          "amount": 1,
          "currency": "USD",
          "fields": {
            "sum_lumen_completed": 9000,
            "sum_lumen_current": 0
          }
        },
        "expected": "not_applicable"
      },
      {
        "name": "authorization excluded",
        "row": {
          "tenant": "paper-kite",
          "risk_type": "lantern-watch",
          "kind": "authorization",
          "amount": 1,
          "currency": "USD",
          "fields": {
            "sum_lumen_completed": 9000,
            "sum_lumen_current": 0
          }
        },
        "expected": "did_not_match"
      },
      {
        "name": "other currency excluded",
        "row": {
          "tenant": "paper-kite",
          "risk_type": "lantern-watch",
          "kind": "settlement",
          "amount": 1,
          "currency": "EUR",
          "fields": {
            "sum_lumen_completed": 9000,
            "sum_lumen_current": 0
          }
        },
        "expected": "did_not_match"
      },
      {
        "name": "missing completed value",
        "row": {
          "tenant": "paper-kite",
          "risk_type": "lantern-watch",
          "kind": "settlement",
          "amount": 1,
          "currency": "USD",
          "fields": {
            "sum_lumen_completed": null,
            "sum_lumen_current": 9000
          }
        },
        "expected": "did_not_match"
      },
      {
        "name": "M1 completed signal with active current day",
        "row": {
          "tenant": "paper-kite",
          "risk_type": "lantern-watch",
          "kind": "settlement",
          "amount": 1,
          "currency": "USD",
          "fields": {
            "sum_lumen_completed": 1251,
            "sum_lumen_current": 9000
          }
        },
        "expected": "matched"
      },
      {
        "name": "M1 completed signal with event amount two",
        "row": {
          "tenant": "paper-kite",
          "risk_type": "lantern-watch",
          "kind": "settlement",
          "amount": 2,
          "currency": "USD",
          "fields": {
            "sum_lumen_completed": 1251,
            "sum_lumen_current": 0
          }
        },
        "expected": "matched"
      },
      {
        "name": "M1 above-threshold GBP excluded",
        "row": {
          "tenant": "paper-kite",
          "risk_type": "lantern-watch",
          "kind": "settlement",
          "amount": 1,
          "currency": "GBP",
          "fields": {
            "sum_lumen_completed": 1251,
            "sum_lumen_current": 0
          }
        },
        "expected": "did_not_match"
      }
    ]
  },
